{
  "schemaVersion": 1,
  "id": "mcbot",
  "version": "${version}",
  "name": "MC Bot Bridge",
  "description": "Environment-integration layer for the RL project. Contains an opt-in experimental world tick gate for lockstep validation; no policy bridge.",
  "authors": [],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.mcbot.McBotMod"
    ],
    "client": [
      "com.mcbot.McBotClient"
    ]
  },
  "mixins": [
    "mcbot.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "minecraft": "~${minecraft}",
    "java": ">=${java}",
    "fabric-api": "*"
  }
}
